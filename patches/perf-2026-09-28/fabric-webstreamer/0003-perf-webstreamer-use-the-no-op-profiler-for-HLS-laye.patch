From 0ac6413a2e02a45b08b66b2ee26d80b8d5bc0fbd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 28 Sep 2026 06:26:22 +0000
Subject: [PATCH 3/3] perf(webstreamer): use the no-op profiler for HLS layers

Each HLS layer built a ProfilerSystem whose push() concatenates the full
section path every call, but its result is never read (the only reader is
commented out). DummyProfiler, which the code already named as the
alternative, keeps the same control flow. Only the profiler's own log lines
(slow-section warnings and push/pop mismatch errors) are no longer emitted.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TD7PJ5R7t7hM3ymeeqXP4H
---
 .../webstreamer/display/render/DisplayLayerHls.java         | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/main/java/fr/theorozier/webstreamer/display/render/DisplayLayerHls.java b/src/main/java/fr/theorozier/webstreamer/display/render/DisplayLayerHls.java
index a97f887..95cd606 100644
--- a/src/main/java/fr/theorozier/webstreamer/display/render/DisplayLayerHls.java
+++ b/src/main/java/fr/theorozier/webstreamer/display/render/DisplayLayerHls.java
@@ -11,7 +11,7 @@ import io.lindstrom.m3u8.parser.ParsingMode;
 import net.fabricmc.api.EnvType;
 import net.fabricmc.api.Environment;
 import net.minecraft.util.math.Vec3i;
-import net.minecraft.util.profiler.ProfilerSystem;
+import net.minecraft.util.profiler.DummyProfiler;
 import net.minecraft.util.profiler.ReadableProfiler;
 import org.bytedeco.javacv.Frame;
 
@@ -97,8 +97,8 @@ public class DisplayLayerHls extends DisplayLayerSimple {
 		super(uri, res);
 		
         this.hlsParser = new MediaPlaylistParser(ParsingMode.LENIENT);
-		this.profiler = new ProfilerSystem(System::nanoTime, () -> 0, true);
-		// this.profiler = DummyProfiler.INSTANCE;
+		// Nothing reads the profile result; a real profiler only cost a path string per push.
+		this.profiler = DummyProfiler.INSTANCE;
   
 		this.asyncPlaylist = new AsyncProcessor<>(this::requestPlaylistBlocking, true);
 		this.asyncGrabbers = new AsyncMap<>(this::requestGrabberBlocking, grabber -> {
