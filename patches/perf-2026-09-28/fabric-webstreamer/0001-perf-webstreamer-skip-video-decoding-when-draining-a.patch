From fa67e1c38928f43327ed6afd28b8471c3d276b5a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 28 Sep 2026 06:24:47 +0000
Subject: [PATCH 1/3] perf(webstreamer): skip video decoding when draining a
 segment

grabRemaining() only forwards audio buffers before the grabber is stopped,
yet grab() decoded and converted every leftover image. JavaCV 1.5.7
grabSamples() is grabFrame(true, false, true, false, false): it reads the
same packets in the same order and feeds every audio packet to the audio
decoder exactly as grab() does, but drops video and data packets without
decoding. The audio frames queued are therefore unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TD7PJ5R7t7hM3ymeeqXP4H
---
 .../theorozier/webstreamer/display/render/FrameGrabber.java   | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/main/java/fr/theorozier/webstreamer/display/render/FrameGrabber.java b/src/main/java/fr/theorozier/webstreamer/display/render/FrameGrabber.java
index d686c53..f24419b 100644
--- a/src/main/java/fr/theorozier/webstreamer/display/render/FrameGrabber.java
+++ b/src/main/java/fr/theorozier/webstreamer/display/render/FrameGrabber.java
@@ -193,8 +193,10 @@ public class FrameGrabber {
 	}
 
 	public void grabRemaining(Consumer<AudioStreamingBuffer> audioBufferConsumer) throws IOException {
+		// Remaining images are discarded, so skip their packets instead of decoding them.
+		// Audio packets reach the audio decoder in the same order either way.
 		Frame frame;
-		while ((frame = this.grabber.grab()) != null) {
+		while ((frame = this.grabber.grabSamples()) != null) {
 			if (frame.samples != null) {
 				audioBufferConsumer.accept(AudioStreamingBuffer.fromFrame(this.tempAudioBuffer, frame));
 			}
