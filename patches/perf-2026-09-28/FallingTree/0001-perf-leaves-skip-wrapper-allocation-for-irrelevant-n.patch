From ebefcc387feae711ee1545828c3aea82366d91ae Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 28 Sep 2026 06:21:45 +0000
Subject: [PATCH] perf(leaves): skip wrapper allocation for irrelevant neighbor
 updates

The updateNeighborsAt/updateNeighborsAtExceptFromFacing hooks allocated
three wrappers, an EnumSet (and a stream/set in the second hook) on every
neighbor update before LeafBreakingHandler#onBlockUpdate rejected almost
all of them. Evaluate the handler's own early exits (leaves breaking
enabled, server level, block is air) on the raw objects first and only
build the wrappers when the handler can act. getBlockState(pos) is still
called unconditionally, as before; the handler keeps its checks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TD7PJ5R7t7hM3ymeeqXP4H
---
 .../fallingtree/fabric/mixin/LevelMixin.java  | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/fabric/src/main/java/fr/rakambda/fallingtree/fabric/mixin/LevelMixin.java b/fabric/src/main/java/fr/rakambda/fallingtree/fabric/mixin/LevelMixin.java
index 57eb34e..a30ecc7 100644
--- a/fabric/src/main/java/fr/rakambda/fallingtree/fabric/mixin/LevelMixin.java
+++ b/fabric/src/main/java/fr/rakambda/fallingtree/fabric/mixin/LevelMixin.java
@@ -9,7 +9,10 @@ import net.minecraft.core.BlockPos;
 import net.minecraft.core.Direction;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
 import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
 import org.spongepowered.asm.mixin.injection.At;
 import org.spongepowered.asm.mixin.injection.Inject;
 import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
@@ -22,10 +25,14 @@ public abstract class LevelMixin{
 	public void updateNeighborsAlways(BlockPos pos, Block block, CallbackInfo callbackInfo){
 		//noinspection ConstantConditions
 		var serverLevel = (ServerLevel) (Object) this;
+		var state = serverLevel.getBlockState(pos);
+		if(!fallingTree$canHandleBlockUpdate(serverLevel, state)){
+			return;
+		}
 		FallingTree.getMod().getLeafBreakingHandler().onBlockUpdate(
 				new ServerLevelWrapper(serverLevel),
 				new BlockPosWrapper(pos),
-				new BlockStateWrapper(serverLevel.getBlockState(pos)),
+				new BlockStateWrapper(state),
 				EnumSet.allOf(DirectionCompat.class));
 	}
 	
@@ -33,13 +40,28 @@ public abstract class LevelMixin{
 	public void updateNeighborsExcept(BlockPos pos, Block sourceBlock, Direction direction, CallbackInfo callbackInfo){
 		//noinspection ConstantConditions
 		var serverLevel = (ServerLevel) (Object) this;
+		var state = serverLevel.getBlockState(pos);
+		if(!fallingTree$canHandleBlockUpdate(serverLevel, state)){
+			return;
+		}
 		var directions = EnumSet.allOf(Direction.class);
 		directions.remove(direction);
 		
 		FallingTree.getMod().getLeafBreakingHandler().onBlockUpdate(
 				new ServerLevelWrapper(serverLevel),
 				new BlockPosWrapper(pos),
-				new BlockStateWrapper(serverLevel.getBlockState(pos)),
+				new BlockStateWrapper(state),
 				directions.stream().map(FallingTree.getMod()::asDirectionCompat).collect(Collectors.toSet()));
 	}
+	
+	/**
+	 * Same early exits as LeafBreakingHandler#onBlockUpdate (leaves breaking enabled, server level, air block),
+	 * checked on the raw objects so the wrappers are only allocated when the handler could act.
+	 */
+	@Unique
+	private static boolean fallingTree$canHandleBlockUpdate(ServerLevel serverLevel, BlockState state){
+		return FallingTree.getMod().getConfiguration().getTrees().isLeavesBreaking()
+				&& !serverLevel.isClientSide()
+				&& Blocks.AIR.equals(state.getBlock());
+	}
 }
