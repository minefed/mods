+++ b/src/main/java/com/jammy1/modernlights/custom/shapes/CeilingLightBlock.java
@@ -12,6 +12,12 @@ import net.minecraft.util.shape.VoxelShapes;
 import net.minecraft.world.BlockView;
 
 public class CeilingLightBlock extends ToggleableWallMountedBlock {
+    private static final VoxelShape NORTH_SHAPE = VoxelShapes.cuboid(0.3125, 0.3125, 0.9375, 0.6875, 0.6875, 1);
+    private static final VoxelShape SOUTH_SHAPE = VoxelShapes.cuboid(0.3125, 0.3125, 0, 0.6875, 0.6875, 0.0625);
+    private static final VoxelShape EAST_SHAPE = VoxelShapes.cuboid(0, 0.3125, 0.3125, 0.0625, 0.6875, 0.6875);
