 .../block/base/entity/MachineBlockEntity.java | 32 +++++++++++++++++--
 .../UpgradableGeneratorBlockEntity.java       |  1 +
 .../oritech/network/NetworkContent.java       |  5 ++-
 4 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/src/main/java/rearth/oritech/block/base/entity/FluidMultiblockGeneratorBlockEntity.java b/src/main/java/rearth/oritech/block/base/entity/FluidMultiblockGeneratorBlockEntity.java
